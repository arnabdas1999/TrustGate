# Copy to .env.gate and fill in. Never commit .env.gate.
# Read ONLY by the gate container. No other process, and no coding agent, should ever see this key.

# Flagsmith organisation API key (project-scoped if your plan allows API-key roles)
FLAGSMITH_API_KEY=
FLAGSMITH_MCP_URL=https://mcp.flagsmith.com
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1

# Same value as in .env: the gate only accepts approvals signed with it
APPROVAL_SIGNING_SECRET=

# Writes are allowed only into this project
FLAGSMITH_PROJECT_ID=
