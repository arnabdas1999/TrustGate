# Copy to .env and fill in. Never commit .env.
# The API, the demo agents and the verifier read this file.
# The Flagsmith ORGANISATION key does NOT go here: it lives only in .env.gate.

# --- Approver login (UI and API) ---
# Set at startup, never committed. Login is disabled while this is empty.
APPROVER_PASSWORD=
APPROVER_NAME=arnab
# Shared with the gate only: the API signs approvals with it (HMAC).
APPROVAL_SIGNING_SECRET=

# --- Flagsmith server-side environment keys (start with "ser.") ---
# Used by the demo agents (SDK, local evaluation) and the verifier (read-back).
FLAGSMITH_SERVER_KEY_OPSPILOT_PROD=
FLAGSMITH_SERVER_KEY_VAULTGUARD_PROD=
FLAGSMITH_SERVER_KEY_BENCH_1=
FLAGSMITH_SERVER_KEY_BENCH_2=
FLAGSMITH_SERVER_KEY_BENCH_3=

# --- LLM provider for the demo agents and the investigator ---
# Claude Pro/Max subscriptions do not include API credits: use a provider key with a hard spending cap.
LLM_PROVIDER=
LLM_API_KEY=
# Real model IDs behind the flag values model_cheap and model_flagship
MODEL_CHEAP=
MODEL_FLAGSHIP=

# --- Wiring ---
GATE_URL=http://localhost:8100
WEB_ORIGIN=http://localhost:3000
# MOCK=1 serves fixture data so the UI can be built before the backend exists
MOCK=1
